# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# The scripts and clients read the environment, not this file. In bash:
#   set -a; . ./.env; set +a

# Required. Create a key in the dashboard: Account, API keys.
MOLOCHAI_API_KEY=your-api-key

# Optional. Defaults to the production API.
MOLOCHAI_BASE_URL=https://api.molochai.dev/api/v1

# For the local mock server instead (node mock-server/server.mjs --port 4010):
# MOLOCHAI_BASE_URL=http://127.0.0.1:4010/api/v1
# MOLOCHAI_API_KEY=mock-key
